#!/usr/bin/env bash
# Claude Code on Qwen3.6-27B (via synthetic.new, through always-on headroom
# :8787 -> model-router :8789).
# Self-contained: sets the proxy config here since ~/.bashrc unsets
# ANTHROPIC_BASE_URL globally (proxy must not leak to other processes).
#   ANTHROPIC_BASE_URL       -> headroom -> model-router
#     body.model = hf:Qwen/Qwen3.6-27B matches the router's synthetic route
#     (^(hf:|syn:)) -> https://api.synthetic.new/anthropic (bearer).
#   ANTHROPIC_CUSTOM_HEADERS -> X-Zai-Session: 1 tells the router to remap any
#     claude-* model (skills asking for sonnet, internal haiku calls) to a z.ai
#     GLM model -- there is no smaller Qwen to fall back to.
#   CLAUDE_CODE_MAX_CONTEXT_TOKENS -> Qwen3.6-27B window is 256k; Claude Code
#     defaults unknown model names to 200k without this.
#   CLAUDE_CODE_AUTO_COMPACT_WINDOW -> compaction threshold, set to the real
#     window so the unrecognized model name gets its true limit enforced (this
#     launcher no longer relies on the global CLAUDE_CODE_DISABLE_1M_CONTEXT flag).
# Print this launcher's name to stderr on exit as a reminder of which command
# started the session -- suppressed in script use (stdout not a terminal, or
# -p/--print present) so it never pollutes output a caller is consuming.
scripted=0
[ -t 1 ] || scripted=1
for arg in "$@"; do
  case "$arg" in -p|--print) scripted=1 ;; esac
done

env \
  ANTHROPIC_BASE_URL="http://127.0.0.1:8787" \
  ANTHROPIC_CUSTOM_HEADERS="X-Zai-Session: 1" \
  CLAUDE_CODE_MAX_CONTEXT_TOKENS=262144 \
  CLAUDE_CODE_AUTO_COMPACT_WINDOW=262144 \
  claude --model hf:Qwen/Qwen3.6-27B "$@"
status=$?

[ "$scripted" -eq 0 ] && printf '%s\n' "$(basename "$0")" >&2
exit $status
